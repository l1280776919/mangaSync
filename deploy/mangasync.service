# 通用模板：按需改 WorkingDirectory / 数据目录
[Unit]
Description=mangaSync 漫画收藏同步系统
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mangasync
Environment=MANGASYNC_HOME=/var/lib/mangasync
ExecStart=/opt/mangasync/mangasync -addr :8787
Restart=on-failure
RestartSec=5
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
